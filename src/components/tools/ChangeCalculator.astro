---
/** Kur değişimi hesaplayıcısı (SPEC §6.9). Mantık: src/lib/tools/change.ts. Yalnızca gereken yıl JSON'ları yüklenir. */
import { CURRENCY_INFO, CURRENCY_ORDER, FIELD_LABELS } from '../../config/currencies.ts';
import { firstDate, lastDate } from '../../lib/data/store.ts';

const firstDates = Object.fromEntries(CURRENCY_ORDER.map((c) => [c, firstDate(c)]));
const last = lastDate();
const minDate = Object.values(firstDates).sort()[0]!;
const defaultStart = `${Number(last.slice(0, 4)) - 1}-01-02`;
---

<div class="tool" data-tool="change" data-first-dates={JSON.stringify(firstDates)} data-last-date={last}>
  <form class="tool__form" novalidate>
    <div class="field">
      <label for="kd-para">Para birimi</label>
      <select class="input" id="kd-para" name="para">
        {CURRENCY_ORDER.map((c) => <option value={c}>{CURRENCY_INFO[c].name} ({c})</option>)}
      </select>
    </div>
    <div class="field">
      <label for="kd-kur">Kur türü</label>
      <select class="input" id="kd-kur" name="kur">
        <option value="forexSelling">{FIELD_LABELS.forexSelling}</option>
        <option value="forexBuying">{FIELD_LABELS.forexBuying}</option>
        <option value="cashSelling">{FIELD_LABELS.cashSelling}</option>
        <option value="cashBuying">{FIELD_LABELS.cashBuying}</option>
      </select>
    </div>
    <div class="field">
      <label for="kd-bas">Başlangıç tarihi</label>
      <input class="input" type="date" id="kd-bas" name="baslangic" min={minDate} max={last} value={defaultStart} required />
    </div>
    <div class="field">
      <label for="kd-bit">Bitiş tarihi</label>
      <input class="input" type="date" id="kd-bit" name="bitis" min={minDate} max={last} value={last} required />
    </div>
    <div class="tool__actions">
      <button class="button" type="submit">Değişimi hesapla</button>
    </div>
    <p class="small muted tool__help">Seçtiğiniz günde TCMB kur belirlemediyse (hafta sonu, resmî tatil, arife) en yakın önceki belirlenme günü kullanılır ve sonuçta belirtilir.</p>
  </form>
  <p class="tool-message" data-message aria-live="polite"></p>
  <p class="visually-hidden" data-announce aria-live="polite"></p>
  <div class="tool-result" data-result></div>
</div>

<script>
  import { calculateChange } from '../../lib/tools/change.ts';
  import { createFetchLoader, ensureRates, ensureYears, RateStore } from '../../lib/tools/rates.ts';
  import { panelsOf, showBusy, showError, showResult, LOAD_FAILED, formatRateFull } from '../../lib/tools/ui.ts';
  import { changeErrorText, renderChange } from '../../lib/tools/ui-change.ts';
  import { formatChange } from '../../lib/formatting/format.ts';
  import { CURRENCY_INFO, FIELD_LABELS } from '../../config/currencies.ts';
  import type { CurrencyCode, RateField } from '../../lib/providers/types.ts';

  const root = document.querySelector<HTMLElement>('[data-tool="change"]');
  if (root) {
    const form = root.querySelector('form')!;
    const coverage = { firstDates: JSON.parse(root.dataset.firstDates!) as Partial<Record<CurrencyCode, string>>, lastDate: root.dataset.lastDate! };
    const panels = panelsOf(root);
    const store = new RateStore();
    const loader = createFetchLoader();
    const empty = new RateStore();
    const field = <T extends HTMLElement>(name: string) => form.elements.namedItem(name) as unknown as T;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const input = {
        currency: field<HTMLSelectElement>('para').value as CurrencyCode,
        field: field<HTMLSelectElement>('kur').value as RateField,
        start: field<HTMLInputElement>('baslangic').value,
        end: field<HTMLInputElement>('bitis').value,
      };
      const pre = calculateChange(empty, input, coverage);
      if ('code' in pre && pre.code !== 'not_loaded') return showError(panels, changeErrorText(pre));
      showBusy(panels, 'Kur verisi yükleniyor…');
      try {
        // Başlangıç ve bitiş yıllarının arasındaki tüm yıllar (grafik için); yıl başı için gerekirse bir önceki yıl.
        await ensureRates(store, loader, [input.currency], input.start, coverage.firstDates);
        await ensureYears(store, loader, Number(input.start.slice(0, 4)), Number(input.end.slice(0, 4)));
      } catch {
        return showError(panels, LOAD_FAILED);
      }
      const result = calculateChange(store, input, coverage);
      if ('code' in result) return showError(panels, changeErrorText(result));
      const spoken = `${CURRENCY_INFO[result.currency].short} ${FIELD_LABELS[result.field].toLowerCase()} kuru ${formatRateFull(result.start.value)} TL'den ${formatRateFull(result.end.value)} TL'ye değişti: ${formatChange(result.percent)}.`;
      showResult(panels, renderChange(result), spoken);
    });
  }
</script>
