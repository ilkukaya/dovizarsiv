---
/** Görünür breadcrumb (SPEC §8). JSON-LD karşılığı BaseLayout'ta aynı listeden üretilir. */
import type { Crumb } from '../lib/seo/schema.ts';

interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Konum">
  <ol>
    {
      crumbs.map((c, i) => (
        <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
      ))
    }
  </ol>
</nav>
